From 26ca804f47473a3152875b47f47381797348b438 Mon Sep 17 00:00:00 2001
From: mphuongth <mphuongth@gmail.com>
Date: Sat, 18 Apr 2026 18:34:19 +0700
Subject: [PATCH] feat(brand): use Cairn icon in sidebar and mobile nav
MIME-Version: 1.0
Content-Type: text/plain; charset=UTF-8
Content-Transfer-Encoding: 8bit

The landing, auth, offline, and favicon surfaces already carry the new
stacked-stones mark. In-app navigation was still showing text-only
wordmarks ("Cairn" and a bare "C" in the collapsed sidebar). This wires
the icon into all three nav surfaces so the brand reads consistently
once you're signed in.

- Sidebar: icon + "Cairn" wordmark when expanded; icon only when
  collapsed (replacing the placeholder "C" letter)
- Mobile Header: icon + wordmark lockup in the center position
  (previously text-only)
- MobileDrawer: icon + wordmark at the top of the drawer
  (previously text-only)

Icon served from the existing /cairn-icon.svg — no new assets, no
script changes. 28–32px sized to sit cleanly at the same visual weight
as the adjacent wordmark.

Co-Authored-By: Claude Opus 4.7 (1M context) <noreply@anthropic.com>
---
 app/components/navigation/Header.tsx       | 14 +++++++++++---
 app/components/navigation/MobileDrawer.tsx | 12 +++++++++++-
 app/components/navigation/Sidebar.tsx      | 14 ++++++++++----
 3 files changed, 32 insertions(+), 8 deletions(-)

diff --git a/app/components/navigation/Header.tsx b/app/components/navigation/Header.tsx
index 868b055..6622dc5 100644
--- a/app/components/navigation/Header.tsx
+++ b/app/components/navigation/Header.tsx
@@ -36,9 +36,17 @@ export default function Header({ onMobileMenuToggle }: HeaderProps) {
       </button>
 
       {/* Mobile center logo */}
-      <span className="lg:hidden flex-1 text-center text-brand font-bold text-lg tracking-tight">
-        Cairn
-      </span>
+      <div className="lg:hidden flex-1 flex items-center justify-center gap-2">
+        {/* eslint-disable-next-line @next/next/no-img-element */}
+        <img
+          src="/cairn-icon.svg"
+          alt="Cairn logo"
+          width={28}
+          height={28}
+          className="h-7 w-7 rounded-md"
+        />
+        <span className="text-brand font-bold text-lg tracking-tight">Cairn</span>
+      </div>
 
       {/* Breadcrumb (desktop/tablet only) */}
       <div className="hidden md:block flex-1">
diff --git a/app/components/navigation/MobileDrawer.tsx b/app/components/navigation/MobileDrawer.tsx
index f8f9ff5..0314c7f 100644
--- a/app/components/navigation/MobileDrawer.tsx
+++ b/app/components/navigation/MobileDrawer.tsx
@@ -66,7 +66,17 @@ export default function MobileDrawer({ open, onClose, email, initials }: MobileD
         aria-label="Navigation menu"
       >
         <div className="flex items-center justify-between px-4 h-14 border-b border-gray-100 dark:border-gray-700">
-          <span className="text-brand font-bold text-xl tracking-tight">Cairn</span>
+          <div className="flex items-center gap-2">
+            {/* eslint-disable-next-line @next/next/no-img-element */}
+            <img
+              src="/cairn-icon.svg"
+              alt="Cairn logo"
+              width={28}
+              height={28}
+              className="h-7 w-7 rounded-md"
+            />
+            <span className="text-brand font-bold text-xl tracking-tight">Cairn</span>
+          </div>
           <button
             onClick={onClose}
             aria-label="Close navigation menu"
diff --git a/app/components/navigation/Sidebar.tsx b/app/components/navigation/Sidebar.tsx
index 420c34b..4f212c0 100644
--- a/app/components/navigation/Sidebar.tsx
+++ b/app/components/navigation/Sidebar.tsx
@@ -34,10 +34,16 @@ export default function Sidebar({ email, initials, onNavClick, hideLogo = false
     >
       {/* Logo */}
       {!hideLogo && (
-        <div className={`flex items-center h-16 px-6 border-b border-gray-100 dark:border-gray-700 ${sidebarCollapsed ? 'justify-center px-0' : ''}`}>
-          {sidebarCollapsed ? (
-            <span className="text-brand font-semibold text-lg">C</span>
-          ) : (
+        <div className={`flex items-center gap-2 h-16 px-6 border-b border-gray-100 dark:border-gray-700 ${sidebarCollapsed ? 'justify-center px-0' : ''}`}>
+          {/* eslint-disable-next-line @next/next/no-img-element */}
+          <img
+            src="/cairn-icon.svg"
+            alt="Cairn logo"
+            width={32}
+            height={32}
+            className="h-8 w-8 rounded-lg shrink-0"
+          />
+          {!sidebarCollapsed && (
             <span className="text-brand font-semibold text-xl">Cairn</span>
           )}
         </div>
-- 
